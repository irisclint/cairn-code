<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Electron's renderer needs a writable, executable JIT heap for V8. Without
      these two entries the hardened runtime kills the process on launch.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- The integrated terminal spawns the user's login shell. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Editing files the user opens, anywhere they choose to open them. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Update checks and, later, the extension marketplace. -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
