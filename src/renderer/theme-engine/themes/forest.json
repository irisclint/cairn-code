    "editorWidget.border": "#1f382b",
    "editorSuggestWidget.background": "#1a2e24",
    "editorSuggestWidget.border": "#1f382b",
    "editorSuggestWidget.foreground": "#c5d8cb",
    "editorSuggestWidget.selectedBackground": "#4ade8040",
    "editorSuggestWidget.highlightForeground": "#4ade80",
    "editorHoverWidget.background": "#1a2e24",
    "editorHoverWidget.border": "#1f382b",
    "activityBar.background": "#0a1611",
