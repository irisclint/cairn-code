    "errorForeground": "#f87171",
    "widget.shadow": "#0000005c",
    "contrastBorder": "#1f382b00",
    "selection.background": "#265c3f",
    "gitDecoration.modifiedResourceForeground": "#fbbf24",
    "gitDecoration.addedResourceForeground": "#4ade80",
    "gitDecoration.deletedResourceForeground": "#f87171",
    "gitDecoration.untrackedResourceForeground": "#4ade80",
    "gitDecoration.conflictingResourceForeground": "#f87171",
    "gitDecoration.ignoredResourceForeground": "#7a8f82",
    "problemsErrorIcon.foreground": "#f87171",
    "problemsWarningIcon.foreground": "#fbbf24",
    "problemsInfoIcon.foreground": "#38bdf8",
    "terminal.ansiBlack": "#1a2e24",
    "terminal.ansiRed": "#f87171",
    "terminal.ansiGreen": "#4ade80",
    "terminal.ansiYellow": "#fcd34d",
    "terminal.ansiBlue": "#38bdf8",
    "terminal.ansiMagenta": "#6ee7b7",
    "terminal.ansiCyan": "#5eead4",
    "terminal.ansiWhite": "#c5d8cb",
    "terminal.ansiBrightBlack": "#3a5648",
    "terminal.ansiBrightRed": "#fca5a5",
    "terminal.ansiBrightGreen": "#86efac",
    "terminal.ansiBrightYellow": "#fde68a",
    "terminal.ansiBrightBlue": "#7dd3fc",
    "terminal.ansiBrightMagenta": "#a7f3d0",
    "terminal.ansiBrightCyan": "#99f6e4",
    "terminal.ansiBrightWhite": "#e6f5ea"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#5a6f62",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#6ee7b7"
      }
    },
    {
      "scope": ["keyword.control", "keyword.operator.new", "keyword.control.flow"],
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#5eead4"
      }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": {
        "foreground": "#fcd34d"
      }
    },
    {
      "scope": ["string.template", "string.interpolated"],
      "settings": {
        "foreground": "#fcd34d"
      }
    },
    {
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": {
        "foreground": "#fcd34d"
      }
    },
    {
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float"],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "scope": ["constant.language", "constant.language.boolean", "constant.language.null"],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "scope": ["constant.other", "variable.other.constant"],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable.name"],
      "settings": {
        "foreground": "#c5d8cb"
      }
    },
    {
      "scope": ["variable.parameter", "meta.function.parameter"],
      "settings": {
        "foreground": "#fcd34d"
      }
    },
    {
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {
        "foreground": "#a7f3d0"
      }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": {
        "foreground": "#a7f3d0"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#a7f3d0"
      }
    },
    {
      "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css"],
      "settings": {
        "foreground": "#a7f3d0"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#7dd3fc",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#fcd34d"
      }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#7dd3fc",
        "fontStyle": "underline"
      }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "meta.brace"],
      "settings": {
        "foreground": "#7a8f82"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#fbbf24",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#fbbf24"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#a7f3d0",
    "type": "#a7f3d0",
    "class": "#a7f3d0",
    "enum": "#a7f3d0",
    "interface": "#a7f3d0",
    "struct": "#a7f3d0",
    "typeParameter": "#a7f3d0",
    "parameter": "#fcd34d",
    "variable": "#c5d8cb",
    "property": "#7dd3fc",
    "enumMember": "#fb923c",
    "decorator": "#7dd3fc",
    "event": "#7dd3fc",
    "function": "#7dd3fc",
    "method": "#7dd3fc",
    "macro": "#7dd3fc",
    "label": "#34d399",
    "comment": "#5a6f62",
    "string": "#fcd34d",
    "keyword": "#6ee7b7",
    "number": "#fb923c",
    "regexp": "#fcd34d",
    "operator": "#5eead4"
  }
}
