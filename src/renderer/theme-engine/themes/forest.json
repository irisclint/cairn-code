    "activityBar.border": "#1f382b",
    "activityBar.activeBorder": "#4ade80",
    "activityBar.activeBackground": "#4ade801a",
    "activityBarBadge.background": "#4ade80",
    "activityBarBadge.foreground": "#0a1611",
    "sideBar.background": "#0e1b15",
    "sideBar.foreground": "#c5d8cb",
    "sideBar.border": "#1f382b",
    "sideBarTitle.foreground": "#7a8f82",
    "sideBarSectionHeader.background": "#1a2e24",
    "sideBarSectionHeader.foreground": "#c5d8cb",
    "sideBarSectionHeader.border": "#1f382b",
    "statusBar.background": "#4ade80",
    "statusBar.foreground": "#0a1611",
    "statusBar.border": "#1f382b",
    "statusBar.noFolderBackground": "#1a2e24",
    "statusBar.noFolderForeground": "#c5d8cb",
    "statusBar.debuggingBackground": "#fbbf24",
    "statusBar.debuggingForeground": "#0a1611",
    "statusBarItem.hoverBackground": "#0a161126",
    "statusBarItem.errorBackground": "#f87171",
    "statusBarItem.errorForeground": "#ffffff",
    "statusBarItem.warningBackground": "#fbbf24",
    "statusBarItem.warningForeground": "#0a1611",
    "titleBar.activeBackground": "#0a1611",
    "titleBar.activeForeground": "#c5d8cb",
    "titleBar.inactiveBackground": "#0a1611",
    "titleBar.inactiveForeground": "#7a8f82",
    "titleBar.border": "#1f382b",
    "tab.activeBackground": "#12211a",
    "tab.activeForeground": "#c5d8cb",
    "tab.activeBorderTop": "#4ade80",
    "tab.inactiveBackground": "#0e1b15",
    "tab.inactiveForeground": "#7a8f82",
    "tab.border": "#1f382b",
    "tab.hoverBackground": "#1a2e24",
    "tab.unfocusedActiveBackground": "#0e1b15",
    "tab.modifiedBorder": "#fbbf24",
    "editorGroupHeader.tabsBackground": "#0e1b15",
    "editorGroupHeader.border": "#1f382b",
    "panel.background": "#0e1b15",
    "panel.border": "#1f382b",
    "panelTitle.activeForeground": "#c5d8cb",
    "panelTitle.inactiveForeground": "#7a8f82",
    "panelTitle.activeBorder": "#4ade80",
    "terminal.background": "#0e1b15",
    "terminal.foreground": "#c5d8cb",
    "terminal.selectionBackground": "#265c3f",
    "terminalCursor.foreground": "#4ade80",
    "terminal.border": "#1f382b",
    "input.background": "#1a2e24",
    "input.foreground": "#c5d8cb",
    "input.border": "#1f382b",
    "input.placeholderForeground": "#7a8f82",
    "inputOption.activeBorder": "#4ade80",
    "inputValidation.errorBackground": "#f8717133",
    "inputValidation.errorBorder": "#f87171",
    "dropdown.background": "#1a2e24",
    "dropdown.foreground": "#c5d8cb",
    "dropdown.border": "#1f382b",
    "button.background": "#4ade80",
    "button.foreground": "#0a1611",
    "button.hoverBackground": "#4ade80d9",
    "button.secondaryBackground": "#1a2e24",
    "button.secondaryForeground": "#c5d8cb",
    "badge.background": "#4ade80",
    "badge.foreground": "#0a1611",
    "list.activeSelectionBackground": "#4ade804d",
    "list.activeSelectionForeground": "#c5d8cb",
    "list.inactiveSelectionBackground": "#4ade8026",
    "list.inactiveSelectionForeground": "#c5d8cb",
    "list.hoverBackground": "#7a8f8226",
    "list.hoverForeground": "#c5d8cb",
    "list.focusOutline": "#4ade80",
    "list.errorForeground": "#f87171",
    "list.warningForeground": "#fbbf24",
    "scrollbarSlider.background": "#7a8f8266",
    "scrollbarSlider.hoverBackground": "#7a8f8299",
    "scrollbarSlider.activeBackground": "#7a8f82cc",
    "notifications.background": "#1a2e24",
    "notifications.foreground": "#c5d8cb",
    "notifications.border": "#1f382b",
    "notificationsErrorIcon.foreground": "#f87171",
    "notificationsWarningIcon.foreground": "#fbbf24",
    "notificationsInfoIcon.foreground": "#38bdf8",
    "breadcrumb.background": "#12211a",
    "breadcrumb.foreground": "#7a8f82",
    "breadcrumb.focusForeground": "#c5d8cb",
    "minimap.background": "#12211a",
    "minimapSlider.background": "#7a8f8233",
    "focusBorder": "#4ade80",
    "foreground": "#c5d8cb",
