{
  "$schema": "https://cairn.dev/schemas/theme.schema.json",
  "id": "midnight-violet",
  "name": "Midnight Violet",
  "type": "dark",
  "description": "A saturated violet night theme with high chroma syntax colours.",
  "author": "cairn Team",
  "license": "MIT",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#17141f",
    "editor.foreground": "#d6d0e8",
    "editor.lineHighlightBackground": "#201b30",
    "editor.lineHighlightBorder": "#2a244080",
    "editor.selectionBackground": "#3f2d66",
    "editor.selectionHighlightBackground": "#3f2d6680",
    "editor.inactiveSelectionBackground": "#3f2d6673",
    "editor.wordHighlightBackground": "#a855f72e",
    "editor.wordHighlightStrongBackground": "#a855f747",
    "editor.findMatchBackground": "#f0b45e73",
