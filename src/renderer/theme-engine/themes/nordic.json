    "editor.rangeHighlightBackground": "#5e81ac1f",
    "editorCursor.foreground": "#5e81ac",
    "editorLineNumber.foreground": "#7b8494",
    "editorLineNumber.activeForeground": "#d8dee9",
    "editorIndentGuide.background": "#3b4252cc",
    "editorIndentGuide.activeBackground": "#7b8494",
    "editorWhitespace.foreground": "#7b849466",
    "editorRuler.foreground": "#3b4252",
    "editorBracketMatch.background": "#5e81ac33",
    "editorBracketMatch.border": "#5e81ac",
    "editorError.foreground": "#bf616a",
    "editorWarning.foreground": "#ebcb8b",
    "editorInfo.foreground": "#5e81ac",
    "editorHint.foreground": "#7b8494",
    "editorGutter.addedBackground": "#a3be8c",
    "editorGutter.modifiedBackground": "#5e81ac",
    "editorGutter.deletedBackground": "#bf616a",
    "editorOverviewRuler.errorForeground": "#bf616a",
    "editorOverviewRuler.warningForeground": "#ebcb8b",
    "editorOverviewRuler.infoForeground": "#5e81ac",
    "editorOverviewRuler.border": "#3b4252",
    "editorWidget.background": "#3b4252",
    "editorWidget.foreground": "#d8dee9",
    "editorWidget.border": "#3b4252",
    "editorSuggestWidget.background": "#3b4252",
    "editorSuggestWidget.border": "#3b4252",
    "editorSuggestWidget.foreground": "#d8dee9",
    "editorSuggestWidget.selectedBackground": "#5e81ac40",
    "editorSuggestWidget.highlightForeground": "#5e81ac",
    "editorHoverWidget.background": "#3b4252",
    "editorHoverWidget.border": "#3b4252",
    "activityBar.background": "#272c36",
    "activityBar.foreground": "#d8dee9",
    "activityBar.inactiveForeground": "#7b8494",
    "activityBar.border": "#3b4252",
    "activityBar.activeBorder": "#5e81ac",
    "activityBar.activeBackground": "#5e81ac1a",
    "activityBarBadge.background": "#5e81ac",
    "activityBarBadge.foreground": "#eceff4",
    "sideBar.background": "#2b303b",
    "sideBar.foreground": "#d8dee9",
    "sideBar.border": "#3b4252",
    "sideBarTitle.foreground": "#7b8494",
    "sideBarSectionHeader.background": "#3b4252",
    "sideBarSectionHeader.foreground": "#d8dee9",
    "sideBarSectionHeader.border": "#3b4252",
    "statusBar.background": "#5e81ac",
    "statusBar.foreground": "#eceff4",
    "statusBar.border": "#3b4252",
    "statusBar.noFolderBackground": "#3b4252",
    "statusBar.noFolderForeground": "#d8dee9",
    "statusBar.debuggingBackground": "#ebcb8b",
    "statusBar.debuggingForeground": "#272c36",
    "statusBarItem.hoverBackground": "#eceff426",
    "statusBarItem.errorBackground": "#bf616a",
    "statusBarItem.errorForeground": "#ffffff",
    "statusBarItem.warningBackground": "#ebcb8b",
    "statusBarItem.warningForeground": "#272c36",
    "titleBar.activeBackground": "#272c36",
    "titleBar.activeForeground": "#d8dee9",
    "titleBar.inactiveBackground": "#272c36",
    "titleBar.inactiveForeground": "#7b8494",
    "titleBar.border": "#3b4252",
    "tab.activeBackground": "#2e3440",
    "tab.activeForeground": "#d8dee9",
    "tab.activeBorderTop": "#5e81ac",
    "tab.inactiveBackground": "#2b303b",
    "tab.inactiveForeground": "#7b8494",
    "tab.border": "#3b4252",
    "tab.hoverBackground": "#3b4252",
    "tab.unfocusedActiveBackground": "#2b303b",
    "tab.modifiedBorder": "#ebcb8b",
    "editorGroupHeader.tabsBackground": "#2b303b",
    "editorGroupHeader.border": "#3b4252",
    "panel.background": "#2b303b",
    "panel.border": "#3b4252",
    "panelTitle.activeForeground": "#d8dee9",
    "panelTitle.inactiveForeground": "#7b8494",
    "panelTitle.activeBorder": "#5e81ac",
    "terminal.background": "#2b303b",
    "terminal.foreground": "#d8dee9",
    "terminal.selectionBackground": "#434c5e",
    "terminalCursor.foreground": "#5e81ac",
    "terminal.border": "#3b4252",
    "input.background": "#3b4252",
    "input.foreground": "#d8dee9",
    "input.border": "#3b4252",
    "input.placeholderForeground": "#7b8494",
    "inputOption.activeBorder": "#5e81ac",
    "inputValidation.errorBackground": "#bf616a33",
    "inputValidation.errorBorder": "#bf616a",
    "dropdown.background": "#3b4252",
    "dropdown.foreground": "#d8dee9",
    "dropdown.border": "#3b4252",
    "button.background": "#5e81ac",
    "button.foreground": "#eceff4",
    "button.hoverBackground": "#5e81acd9",
    "button.secondaryBackground": "#3b4252",
    "button.secondaryForeground": "#d8dee9",
    "badge.background": "#5e81ac",
    "badge.foreground": "#eceff4",
    "list.activeSelectionBackground": "#5e81ac4d",
    "list.activeSelectionForeground": "#d8dee9",
    "list.inactiveSelectionBackground": "#5e81ac26",
    "list.inactiveSelectionForeground": "#d8dee9",
    "list.hoverBackground": "#7b849426",
    "list.hoverForeground": "#d8dee9",
    "list.focusOutline": "#5e81ac",
    "list.errorForeground": "#bf616a",
    "list.warningForeground": "#ebcb8b",
    "scrollbarSlider.background": "#7b849466",
    "scrollbarSlider.hoverBackground": "#7b849499",
    "scrollbarSlider.activeBackground": "#7b8494cc",
    "notifications.background": "#3b4252",
    "notifications.foreground": "#d8dee9",
    "notifications.border": "#3b4252",
    "notificationsErrorIcon.foreground": "#bf616a",
    "notificationsWarningIcon.foreground": "#ebcb8b",
    "notificationsInfoIcon.foreground": "#5e81ac",
    "breadcrumb.background": "#2e3440",
    "breadcrumb.foreground": "#7b8494",
    "breadcrumb.focusForeground": "#d8dee9",
    "minimap.background": "#2e3440",
    "minimapSlider.background": "#7b849433",
    "focusBorder": "#5e81ac",
    "foreground": "#d8dee9",
    "descriptionForeground": "#7b8494",
    "errorForeground": "#bf616a",
    "widget.shadow": "#0000005c",
    "contrastBorder": "#3b425200",
    "selection.background": "#434c5e",
    "gitDecoration.modifiedResourceForeground": "#ebcb8b",
    "gitDecoration.addedResourceForeground": "#a3be8c",
    "gitDecoration.deletedResourceForeground": "#bf616a",
    "gitDecoration.untrackedResourceForeground": "#a3be8c",
    "gitDecoration.conflictingResourceForeground": "#bf616a",
    "gitDecoration.ignoredResourceForeground": "#7b8494",
    "problemsErrorIcon.foreground": "#bf616a",
    "problemsWarningIcon.foreground": "#ebcb8b",
    "problemsInfoIcon.foreground": "#5e81ac",
    "terminal.ansiBlack": "#3b4252",
    "terminal.ansiRed": "#bf616a",
    "terminal.ansiGreen": "#a3be8c",
    "terminal.ansiYellow": "#ebcb8b",
    "terminal.ansiBlue": "#81a1c1",
    "terminal.ansiMagenta": "#b48ead",
    "terminal.ansiCyan": "#88c0d0",
    "terminal.ansiWhite": "#e5e9f0",
    "terminal.ansiBrightBlack": "#4c566a",
    "terminal.ansiBrightRed": "#d08770",
    "terminal.ansiBrightGreen": "#b9d3a0",
    "terminal.ansiBrightYellow": "#f0d8a8",
    "terminal.ansiBrightBlue": "#8fbcbb",
    "terminal.ansiBrightMagenta": "#c9a4c4",
    "terminal.ansiBrightCyan": "#9fd6e0",
    "terminal.ansiBrightWhite": "#eceff4"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#616e88",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": ["keyword.control", "keyword.operator.new", "keyword.control.flow"],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "scope": ["string.template", "string.interpolated"],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float"],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "scope": ["constant.language", "constant.language.boolean", "constant.language.null"],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "scope": ["constant.other", "variable.other.constant"],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable.name"],
      "settings": {
        "foreground": "#d8dee9"
      }
    },
    {
      "scope": ["variable.parameter", "meta.function.parameter"],
      "settings": {
        "foreground": "#d8dee9"
      }
    },
    {
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": {
        "foreground": "#8fbcbb"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {
        "foreground": "#8fbcbb"
      }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": {
        "foreground": "#8fbcbb"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#8fbcbb"
      }
    },
    {
      "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css"],
      "settings": {
        "foreground": "#8fbcbb"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#88c0d0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#8fbcbb",
        "fontStyle": "underline"
      }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "meta.brace"],
      "settings": {
        "foreground": "#7b8494"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#bf616a"
      }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#ebcb8b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": {
        "foreground": "#bf616a"
      }
    },
    {
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#ebcb8b"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8fbcbb",
    "type": "#8fbcbb",
    "class": "#8fbcbb",
    "enum": "#8fbcbb",
    "interface": "#8fbcbb",
    "struct": "#8fbcbb",
    "typeParameter": "#8fbcbb",
    "parameter": "#d8dee9",
    "variable": "#d8dee9",
    "property": "#8fbcbb",
    "enumMember": "#b48ead",
    "decorator": "#88c0d0",
    "event": "#88c0d0",
    "function": "#88c0d0",
    "method": "#88c0d0",
    "macro": "#88c0d0",
    "label": "#b48ead",
    "comment": "#616e88",
    "string": "#a3be8c",
    "keyword": "#81a1c1",
    "number": "#b48ead",
    "regexp": "#ebcb8b",
    "operator": "#81a1c1"
  }
}
