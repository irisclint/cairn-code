  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#586e75",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "scope": ["keyword.control", "keyword.operator.new", "keyword.control.flow"],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "scope": ["string.template", "string.interpolated"],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float"],
      "settings": {
        "foreground": "#d33682"
      }
    },
    {
      "scope": ["constant.language", "constant.language.boolean", "constant.language.null"],
      "settings": {
        "foreground": "#d33682"
      }
    },
    {
      "scope": ["constant.other", "variable.other.constant"],
      "settings": {
        "foreground": "#d33682"
      }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable.name"],
      "settings": {
        "foreground": "#93a1a1"
      }
    },
    {
      "scope": ["variable.parameter", "meta.function.parameter"],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#93a1a1"
      }
    },
    {
      "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css"],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#268bd2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#268bd2",
        "fontStyle": "underline"
      }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "meta.brace"],
      "settings": {
        "foreground": "#586e75"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#b58900",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#b58900"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#b58900",
    "type": "#b58900",
    "class": "#b58900",
    "enum": "#b58900",
    "interface": "#b58900",
    "struct": "#b58900",
    "typeParameter": "#b58900",
    "parameter": "#cb4b16",
    "variable": "#93a1a1",
    "property": "#268bd2",
    "enumMember": "#d33682",
    "decorator": "#268bd2",
    "event": "#268bd2",
    "function": "#268bd2",
    "method": "#268bd2",
    "macro": "#268bd2",
    "label": "#cb4b16",
    "comment": "#586e75",
    "string": "#2aa198",
    "keyword": "#859900",
    "number": "#d33682",
    "regexp": "#dc322f",
    "operator": "#859900"
  }
}
