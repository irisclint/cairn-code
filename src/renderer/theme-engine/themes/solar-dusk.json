    "tab.activeBorderTop": "#b58900",
    "tab.inactiveBackground": "#01252e",
    "tab.inactiveForeground": "#586e75",
    "tab.border": "#073642",
    "tab.hoverBackground": "#073642",
    "tab.unfocusedActiveBackground": "#01252e",
    "tab.modifiedBorder": "#b58900",
    "editorGroupHeader.tabsBackground": "#01252e",
    "editorGroupHeader.border": "#073642",
    "panel.background": "#01252e",
    "panel.border": "#073642",
    "panelTitle.activeForeground": "#93a1a1",
    "panelTitle.inactiveForeground": "#586e75",
    "panelTitle.activeBorder": "#b58900",
    "terminal.background": "#01252e",
    "terminal.foreground": "#93a1a1",
    "terminal.selectionBackground": "#0a4a5a",
    "terminalCursor.foreground": "#b58900",
    "terminal.border": "#073642",
    "input.background": "#073642",
    "input.foreground": "#93a1a1",
    "input.border": "#073642",
    "input.placeholderForeground": "#586e75",
    "inputOption.activeBorder": "#b58900",
    "inputValidation.errorBackground": "#dc322f33",
    "inputValidation.errorBorder": "#dc322f",
    "dropdown.background": "#073642",
    "dropdown.foreground": "#93a1a1",
    "dropdown.border": "#073642",
    "button.background": "#b58900",
    "button.foreground": "#002b36",
    "button.hoverBackground": "#b58900d9",
    "button.secondaryBackground": "#073642",
    "button.secondaryForeground": "#93a1a1",
    "badge.background": "#b58900",
    "badge.foreground": "#002b36",
    "list.activeSelectionBackground": "#b589004d",
    "list.activeSelectionForeground": "#93a1a1",
    "list.inactiveSelectionBackground": "#b5890026",
    "list.inactiveSelectionForeground": "#93a1a1",
    "list.hoverBackground": "#586e7526",
