    "statusBar.border": "#073642",
    "statusBar.noFolderBackground": "#073642",
    "statusBar.noFolderForeground": "#93a1a1",
    "statusBar.debuggingBackground": "#b58900",
    "statusBar.debuggingForeground": "#011f27",
    "statusBarItem.hoverBackground": "#002b3626",
